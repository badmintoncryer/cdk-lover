{
  "name": "@repo/webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3010",
    "build": "next build",
    "start": "next start",
    "test:unit": "vitest run --exclude '**/*.integ.test.ts'",
    "test:watch": "vitest --exclude '**/*.integ.test.ts'",
    "format": "oxfmt --write .",
