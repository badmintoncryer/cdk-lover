    "@repo/db": "workspace:*",
    "@repo/event-utils": "workspace:*",
    "aws-amplify": "^6.22.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45",
    "lucide-react": "^0.488.0",
    "next": "^16.4.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.2.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@radix-ui/react-slot": "^1.5.0",
